          "input": {
            "type": "status",
            "payload": {
              "status": "worker_heartbeat_note",
              "note": "c2-p"
            }
          }
        },
        {
          "op": "deliver",
          "key": "sf-c2-p"
        },
        {
          "op": "ack",
          "key": "sf-c2-p"
        },
        {
          "op": "append",
          "key": "sf-c2-a",
          "port": "appendSystemEvent",
          "input": {
            "type": "status",
            "payload": {
              "status": "worker_heartbeat_note",
              "note": "c2-a"
            }
          }
        },
        {
          "op": "deliver",
          "key": "sf-c2-a",
          "failAt": "afterDeliver"
        },
        {
          "op": "crash"
        },
        {
          "op": "reopen"
        },
        {
          "op": "append",
          "key": "sf-c2-n",
          "port": "appendSystemEvent",
          "input": {
            "type": "status",
            "payload": {
              "status": "worker_heartbeat_note",
              "note": "c2-n"
            }
          }
        }
      ],
      "expected": {
        "deliveredBeforeCrash": ["sf-c2-p", "sf-c2-a"],
        "cursorAtCrashKey": "sf-c2-p",
        "deliveredAfterReopen": ["sf-c2-a", "sf-c2-n"],
        "upsertOnce": ["sf-c2-p", "sf-c2-a", "sf-c2-n"],
